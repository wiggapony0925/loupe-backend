{%- macro movers_table(rows, is_gain) -%}
<table class="data-table movers">
  <thead>
    <tr>
      <th class="thumb"></th>
      <th>Card</th>
      <th>Set</th>
      <th class="num">Closing value</th>
      <th class="num">Period change</th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
    {% set art = thumb(r.card_id) %}
    <tr>
      <td class="thumb">{% if art %}<img src="{{ art }}" alt="">{% endif %}</td>
      <td class="card-name">{{ r.name }}</td>
      <td class="set">{{ r.set_name or "—" }}</td>
      <td class="num">{{ r.value_close_usd | money }}</td>
      <td class="num {{ 'up' if is_gain else 'down' }}">{{ r.delta_usd | money }} ({{ r.delta_pct | pct }})</td>
    </tr>
    {% else %}
    <tr><td class="thumb"></td><td colspan="4" class="empty-cell">No movers in this category.</td></tr>
    {% endfor %}
  </tbody>
</table>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Loupe Portfolio Statement — {{ period_label }}</title>
</head>
<body>
  <div class="run run-brand">Loupe · Portfolio Statement</div>
  <div class="run run-period">{{ period_label }}</div>
  <div class="run run-generated">Generated {{ generated_at }}</div>
  <div class="run run-email">{{ user_email }}</div>

  {# ─── Cover ─────────────────────────────────────────────────────────── #}
  <section class="page cover">
    <header class="cover-header">
      <div class="cover-brand">
        <div class="cover-mark">Loupe</div>
        <div class="cover-type">Portfolio Statement</div>
      </div>
      <div class="cover-meta">
        <div class="cover-meta-label">Statement period</div>
        <div class="cover-meta-value">{{ period_start_long }} – {{ period_end_long }}</div>
        <div class="cover-meta-sub">Issued {{ statement_date }}</div>
      </div>
    </header>

    {% if collection_name %}
    <div class="scope-badge">Collection: {{ collection_name }}</div>
    {% endif %}

    <div class="balance-block">
      <div class="balance-label">Closing balance</div>
      <div class="balance-value">{{ closing_value_usd | money }}</div>
      <div class="balance-change {{ 'up' if up else 'down' }}">
        Period change {{ delta_usd | money }} ({{ delta_pct | pct }})
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat">
        <div class="stat-label">Opening balance</div>
        <div class="stat-value">{{ opening_value_usd | money }}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Unrealized P/L</div>
        <div class="stat-value {{ pnl_class }}">{{ unrealized_pnl_usd | money }}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Holdings</div>
        <div class="stat-value">{{ "{:,}".format(card_count) }}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Average grade</div>
        <div class="stat-value">{{ ("%.1f" % avg_grade) if avg_grade else "—" }}</div>
      </div>
    </div>

    <table class="ledger">
      <thead>
        <tr>
          <th colspan="2">Account summary</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lbl">Account holder</td>
          <td class="val">{{ account_holder }}</td>
        </tr>
        <tr>
          <td class="lbl">Account email</td>
          <td class="val">{{ user_email }}</td>
        </tr>
        <tr>
          <td class="lbl">Statement period</td>
          <td class="val">{{ period_start_long }} – {{ period_end_long }}</td>
        </tr>
        <tr>
          <td class="lbl">Opening balance</td>
          <td class="val">{{ opening_value_usd | money }}</td>
        </tr>
        <tr>
          <td class="lbl">Closing balance</td>
          <td class="val">{{ closing_value_usd | money }}</td>
        </tr>
        <tr>
          <td class="lbl">Period change</td>
          <td class="val {{ 'up' if up else 'down' }}">{{ delta_usd | money }} ({{ delta_pct | pct }})</td>
        </tr>
        <tr>
          <td class="lbl">Total cost basis</td>
          <td class="val">{{ total_cost_usd | money }}</td>
        </tr>
        <tr>
          <td class="lbl">Unrealized gain/loss</td>
          <td class="val {{ pnl_class }}">{{ unrealized_pnl_usd | money }}{% if unrealized_pnl_pct is not none %} ({{ unrealized_pnl_pct | pct }}){% endif %}</td>
        </tr>
      </tbody>
    </table>

    <p class="disclaimer">
      Values reflect Loupe market estimates for graded holdings as of the statement
      close date. This document is provided for record-keeping and is not tax,
      legal, or investment advice.
    </p>
  </section>

  {# ─── Performance ───────────────────────────────────────────────────── #}
  <section class="page">
    <h2 class="section-title">Portfolio performance</h2>
    <p class="section-lead">Estimated daily portfolio value across the statement period.</p>
    {% if area_svg %}
      <div class="chart">{{ area_svg | safe }}</div>
    {% else %}
      <div class="empty">
        Insufficient price history was available to chart this period. Future
        statements will include a daily value curve as market data accumulates.
      </div>
    {% endif %}
  </section>

  {# ─── Allocation ──────────────────────────────────────────────────────── #}
  <section class="page">
    <h2 class="section-title">Portfolio composition</h2>
    {% if legend %}
      <p class="section-lead">Allocation by game at period close.</p>
      <div class="alloc">
        <div class="donut">{{ donut_svg | safe }}</div>
        <ul class="legend">
          {% for item in legend %}
          <li>
            <span class="sw" style="background: {{ item.color }}"></span>
            <span class="name">{{ item.name }}</span>
            <span class="val">{{ item.value | money }}</span>
            <span class="pct">{{ item.pct }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>

      <h3 class="subsection-title">Grade distribution</h3>
      {% if bar_svg %}
        <div class="chart">{{ bar_svg | safe }}</div>
      {% else %}
        <div class="empty">No graded holdings to display.</div>
      {% endif %}
    {% else %}
      <div class="empty">No holdings were in the vault during this period.</div>
    {% endif %}
  </section>

  {# ─── Top movers ────────────────────────────────────────────────────── #}
  <section class="page">
    <h2 class="section-title">Price movement</h2>
    <p class="section-lead">Largest estimated value changes during the statement period.</p>
    {% if top_gainers or top_losers %}
      <div class="rowhead">Top gainers</div>
      {{ movers_table(top_gainers, true) }}
      <div class="rowhead">Top decliners</div>
      {{ movers_table(top_losers, false) }}
    {% else %}
      <div class="empty">No measurable price movement occurred during this period.</div>
    {% endif %}
  </section>

  {% if gallery %}
  <section class="page">
    <h2 class="section-title">Largest holdings</h2>
    <p class="section-lead">Highest-value positions at period close.</p>
    <div class="gallery">
      {% for h in gallery %}
      <div class="g-card">
        <img class="g-art" src="{{ h.art }}" alt="">
        <div class="g-meta">
          <div class="g-name">{{ h.name }}</div>
          <div class="g-grade">Grade {{ "%.1f" % h.grade }}</div>
          <div>
            <span class="g-value">{{ h.value_close_usd | money }}</span>
            <span class="g-delta {{ 'up' if h.delta_pct >= 0 else 'down' }}">{{ h.delta_pct | pct }}</span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ─── Holdings ──────────────────────────────────────────────────────── #}
  <section class="page">
    <h2 class="section-title">Holdings detail</h2>
    {% if holdings %}
      <p class="section-lead">
        All positions valued at period open and close.
        {% if holdings_truncated %}
          Showing {{ holdings | length }} of {{ holdings_total }} holdings, sorted by closing value.
        {% else %}
          {{ holdings_total }} position{{ "s" if holdings_total != 1 else "" }}, sorted by closing value.
        {% endif %}
      </p>
      <table class="data-table holdings">
        <thead>
          <tr>
            <th>Card</th>
            <th>Set</th>
            <th class="num">Grade</th>
            <th class="num">Opening</th>
            <th class="num">Closing</th>
            <th class="num">Change</th>
          </tr>
        </thead>
        <tbody>
          {% for h in holdings %}
          <tr>
            <td class="card-name">{{ h.name }}</td>
            <td class="set">{{ h.set_name or "—" }}</td>
            <td class="num">{{ "%.1f" % h.grade }}</td>
            <td class="num">{{ h.value_open_usd | money }}</td>
            <td class="num">{{ h.value_close_usd | money }}</td>
            <td class="num {{ 'up' if h.delta_pct >= 0 else 'down' }}">{{ h.delta_pct | pct }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">No holdings were recorded for this statement period.</div>
    {% endif %}
  </section>
</body>
</html>
