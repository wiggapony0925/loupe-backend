# --- App ---
APP_ENV=development              # development | staging | production
APP_NAME=loupe-backend
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true for JSON structured logs (production)

# --- Server ---
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1                # gunicorn worker count

# --- Database ---
# Exactly THREE supported ways to reach Postgres (see DEPLOY.md):
#   1. Local Docker (this default): docker-compose publishes Postgres on host
#      port 5433 → postgresql+asyncpg://loupe:loupe@localhost:5433/loupe
#   2. Cloud SQL unix socket (production on Cloud Run): set via the
#      `database-url` secret, NOT here →
#      postgresql+asyncpg://loupe:PASS@/loupe?host=/cloudsql/PROJECT:REGION:INSTANCE
#   3. Cloud SQL Auth Proxy (local against prod DB): run the proxy, then point
#      at the loopback it exposes → postgresql+asyncpg://loupe:PASS@localhost:5432/loupe
# Tests use sqlite+aiosqlite:// (overridden in tests/conftest.py).
#
# NEVER point DATABASE_URL at the Cloud SQL *public IP* (e.g. 34.x.x.x). That
# instance has no authorized networks and SSL-resets the handshake, surfacing
# as a cryptic `ConnectionResetError: [Errno 54] Connection reset by peer` deep
# in asyncpg. app/db/session.py now fails fast with a clear DatabaseConfigError
# if it sees a raw-IP Postgres host while CLOUD_SQL_CONNECTION_NAME is set.
DATABASE_URL=postgresql+asyncpg://loupe:loupe@localhost:5433/loupe

# --- Redis (cache + arq queue) ---
# Local: docker-compose Redis on localhost:6379.
# Production (Cloud Run): a Memorystore instance reached over a VPC connector,
# injected via the `redis-url` secret (e.g. redis://10.x.x.x:6379/0). Without a
# reachable Redis the app degrades gracefully to an in-process cache
# (app/platform/redis_client.py) — fine for correctness, slower under load.
REDIS_URL=redis://localhost:6379/0

# --- JWT (issue our own access + refresh tokens) ---
# Use RS256; provide PEM-encoded keys (escape newlines as \n in shell envs).
JWT_ISSUER=https://api.loupe.app
JWT_AUDIENCE=loupe-mobile
# Leave these empty in dev to auto-generate an ephemeral RSA key.
# Provide PEM-encoded RSA keys in staging/production.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL_SECONDS=900         # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000    # 30 days

# --- Apple Sign-In ---
APPLE_CLIENT_ID=com.loupe.app
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com

# --- Google Sign-In ---
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUER=https://accounts.google.com

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000   # blank for AWS prod
S3_REGION=us-east-1
S3_BUCKET=loupe-scans
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_EXPIRES_SECONDS=900           # 15 minutes

# --- Upstream card-catalog APIs (free tier; keys optional) ---
POKEMON_TCG_API_KEY=
SCRYFALL_BASE_URL=https://api.scryfall.com
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
POKEMON_TCG_BASE_URL=https://api.pokemontcg.io/v2

# --- Pricing APIs (require paid creds; blank disables) ---
TCGPLAYER_CLIENT_ID=
TCGPLAYER_CLIENT_SECRET=
EBAY_APP_ID=
EBAY_CERT_ID=
PRICECHARTING_API_KEY=
SCI_API_KEY=

# --- Real Data Provider APIs (optional; progressive lightup) ---
# eBay Browse + Marketplace Insights — https://developer.ebay.com (Marketplace Insights needs approval)
EBAY_OAUTH_TOKEN=                  # optional pre-minted user token (else app/cert minted)
# PSA Public API — https://www.psacard.com/publicapi (free)
PSA_API_TOKEN=
# TCGplayer API — https://docs.tcgplayer.com (requires partner approval)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
# PriceCharting — https://www.pricecharting.com/api-documentation (~$20-50/mo)
PRICECHARTING_TOKEN=
# GoCollect (stub; paid) — https://gocollect.com
GOCOLLECT_API_KEY=

# --- Apify — Facebook Marketplace nearby listings ---
# https://apify.com — powers the "Near You" carousel on the card-detail sheet.
# Blank disables the feature (client renders an enable-location CTA / empty state).
APIFY_API_TOKEN=
APIFY_FB_MARKETPLACE_ACTOR=apify/facebook-marketplace-scraper

# --- HTTP client ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE=10

# --- Billing / Loupe Pro (Stripe; optional — blank disables, app stays free) ---
# Run scripts/stripe_setup.sh to create the product + prices and print these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
PRO_PRICE_MONTHLY_USD=9.99
PRO_PRICE_YEARLY_USD=99
# Where Stripe Checkout returns after success / cancel (local dev shown).
BILLING_SUCCESS_URL=http://localhost:5173/app/settings?upgraded=1
BILLING_CANCEL_URL=http://localhost:5173/app/settings

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Authorization ---
# Comma-separated admin allowlist. These accounts can reach the developer
# portal (/admin) and admin API. Compared case-insensitively to the user email.
ADMIN_EMAILS=

# --- Email (transactional, via Resend — optional) ---
# When both are set, applicant status updates are emailed via Resend
# (https://resend.com — cheap, generous free tier). Leave blank to disable
# (updates are still recorded and visible on the public tracking page).
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=Loupe Careers <careers@loupe.app>
# Public base URL of the web app, used to build links inside emails.
APP_PUBLIC_URL=https://loupe.app
